datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String              @id @default(cuid())
  fullName         String
  email            String              @unique
  phone            String
  passwordHash     String
  organizationType String              @default("Individual")
  isVerified       Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  sessions         Session[]
  bookings         Booking[]
  paymentAttempts  PaymentAttempt[]
  verifications    EmailVerification[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String
  userAgent String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Booking {
  id               String           @id @default(cuid())
  userId           String?
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientName       String
  phone            String
  eventDate        DateTime
  guestCount       Int
  organizationType String           @default("Individual")
  packageTier      String           @default("StandardParty")
  totalAmount      Decimal          @default(150000.00) @db.Decimal(12, 2)
  depositRequired  Decimal          @default(90000.00) @db.Decimal(12, 2)
  depositPaid      Decimal          @default(0.00) @db.Decimal(12, 2)
  status           String           @default("CONFIRMED")
  cancellationReason String
  holdExpiresAt    DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  paymentAttempts  PaymentAttempt[]

  @@index([eventDate])
  @@index([userId, status])
}

model PaymentAttempt {
  id               String   @id @default(cuid())
  bookingId        String
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  amountAttempted  Decimal  @db.Decimal(12, 2)
  paymentChannel   String
  gatewayReference String?  @unique
  status           String   @default("INITIATED")
  errorCode        String?
  errorMessage     String?
  ipAddress        String
  attemptedAt      DateTime @default(now())

  @@index([bookingId, attemptedAt])
  @@index([status])
}

model RetrievalChunk {
  id            String   @id @default(cuid())
  documentTitle String
  category      String
  content       String   @db.Text
  tokenCount    Int
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([category, documentTitle])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
